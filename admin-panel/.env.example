# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Credenciais do único usuário admin.
# ADMIN_PASSWORD_HASH é gerado com: npm run create-admin -- <usuario> <senha>
# Nunca coloque a senha em texto puro aqui — só o hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Banco Turso (libSQL hospedado) — crie em https://turso.tech (free tier).
# TURSO_DATABASE_URL tem o formato libsql://<nome-do-banco>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Bridge de upload no cPanel (ver cpanel-bridge/README.md). O token aqui tem
# que ser IDÊNTICO ao definido em upload-secret.php no servidor.
UPLOAD_BRIDGE_URL=https://rogeriomessdj.com.br/upload.php
UPLOAD_BRIDGE_TOKEN=

NODE_ENV=development
