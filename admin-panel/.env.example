# Segredo usado para assinar o cookie de sessão do admin.
# Gere um valor forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Credenciais do único usuário admin.
# ADMIN_PASSWORD_HASH é gerado com: npm run create-admin -- <usuario> <senha>
# Nunca coloque a senha em texto puro aqui — só o hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Onde o banco SQLite e os MP3s ficam salvos.
# Caminhos relativos são resolvidos a partir da raiz do projeto (persistente na VPS/cPanel).
DATA_DIR=./data
MEDIA_DIR=./public/media

# Porta usada pelo server.js. O cPanel (via Passenger) injeta PORT automaticamente
# na app Node.js — não é necessário fixar em produção.
PORT=3000
NODE_ENV=development
